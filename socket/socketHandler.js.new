const jwt = require('jsonwebtoken');
const Message = require('../models/Message.model');
const Chat = require('../models/Chat.model');
const User = require('../models/User.model');
const { JWT_SECRET } = require('../config/constants');
const {
    setUserOnline,
    setUserOffline,
    setTyping,
    getTypingUsers,
    setUserLocation
} = require('../config/redis');

// Store active socket connections
const userSockets = new Map(); // userId -> socketId

module.exports = (io) => {
    // Middleware for socket authentication
    io.use(async (socket, next) => {
        try {
            const token = socket.handshake.auth.token || socket.handshake.headers.authorization?.replace('Bearer ', '');

            if (!token) {
                return next(new Error('Authentication error: No token provided'));
            }

            const decoded = jwt.verify(token, JWT_SECRET);
            const user = await User.findById(decoded.userId).select('-password');

            if (!user) {
                return next(new Error('Authentication error: User not found'));
            }

            socket.userId = user._id.toString();
            socket.user = user;
            next();
        } catch (error) {
            console.error('Socket authentication error:', error);
            next(new Error('Authentication error'));
        }
    });

    io.on('connection', async (socket) => {
        console.log(`✅ User connected: ${socket.userId}`);

        // Store socket connection
        userSockets.set(socket.userId, socket.id);

        // Immediate status update (Non-blocking)
        setUserOnline(socket.userId, socket.id).catch(err => console.error('Redis online error:', err));
        User.findByIdAndUpdate(socket.userId, { isOnline: true, lastSeen: new Date() }).catch(err => console.error('DB online error:', err));

        // Join user's chat rooms (Non-blocking)
        Chat.find({ participants: socket.userId, isActive: true })
            .then(chats => {
                chats.forEach(chat => socket.join(chat._id.toString()));
            })
            .catch(err => console.error('Auto-join rooms error:', err));

        // Debug: Log all events
        socket.onAny((event, ...args) => {
            console.log(`📩 Event from ${socket.userId}: ${event}`, args);
        });

        // ==================== SOCKET EVENTS ====================

        // Join a specific chat room
        socket.on('chat:join', async (data) => {
            try {
                const { chatId } = data;
                console.log(`📡 User ${socket.userId} joining chat: ${chatId}`);

                // Verify user is part of the chat
                const chat = await Chat.findOne({
                    _id: chatId,
                    participants: socket.userId
                });

                if (chat) {
                    socket.join(chatId);
                    console.log(`✅ User ${socket.userId} joined room: ${chatId}`);
                    socket.emit('chat:joined', { chatId, success: true });
                } else {
                    console.log(`❌ User ${socket.userId} denied access to chat: ${chatId}`);
                    socket.emit('error', { message: 'Chat not found or access denied' });
                }
            } catch (error) {
                console.error('Join chat error:', error);
                socket.emit('error', { message: 'Error joining chat' });
            }
        });

        // Send message
        socket.on('message:send', async (data) => {
            try {
                const { chatId, content, type = 'text', replyTo, media, location } = data;
                console.log(`📩 Message from ${socket.userId} to ${chatId}: ${content}`);

                // Verify user is part of the chat
                const chat = await Chat.findOne({
                    _id: chatId,
                    participants: socket.userId
                });

                if (!chat) {
                    console.log(`❌ Message denied: ${socket.userId} not in chat ${chatId}`);
                    return socket.emit('error', { message: 'Chat not found' });
                }

                // Create message
                const message = new Message({
                    chat: chatId,
                    sender: socket.userId,
                    content,
                    type,
                    replyTo: replyTo || undefined,
                    media: media || undefined,
                    location: location || undefined
                });

                await message.save();
                await message.populate('sender', '-password');

                // Update chat's last message and unread count
                await Chat.findByIdAndUpdate(chatId, {
                    lastMessage: message._id,
                    $set: { [`unreadCount.${socket.userId}`]: 0 } // Reset sender unread
                });

                // Emit message to all participants in the chat room
                io.to(chatId).emit('message:new', {
                    message,
                    chatId
                });
                console.log(`📤 Message ${message._id} emitted to room ${chatId}`);

            } catch (error) {
                console.error('Send message error:', error);
                socket.emit('error', { message: 'Error sending message' });
            }
        });

        // ... other events (omitted for brevity in this scratch file but I'll keep them in the real file)
        
        socket.on('disconnect', async () => {
            console.log(`❌ User disconnected: ${socket.userId}`);
            userSockets.delete(socket.userId);
            setUserOffline(socket.userId).catch(err => console.error('Redis offline error:', err));
            User.findByIdAndUpdate(socket.userId, { isOnline: false, lastSeen: new Date() }).catch(err => console.error('DB offline error:', err));
        });
    });

    return io;
};
