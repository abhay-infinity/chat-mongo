{
    "info": {
        "name": "Nearby Chat API",
        "description": "Complete API collection for Nearby Chat application",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:5000/api"
        },
        {
            "key": "token",
            "value": ""
        }
    ],
    "item": [
        {
            "name": "Authentication",
            "item": [
                {
                    "name": "Register",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": "{{baseUrl}}/auth/register",
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"username\": \"testuser\",\n  \"email\": \"test@example.com\",\n  \"phone\": \"+1234567890\",\n  \"password\": \"password123\"\n}"
                        }
                    }
                },
                {
                    "name": "Login",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": "{{baseUrl}}/auth/login",
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"identifier\": \"test@example.com\",\n  \"password\": \"password123\"\n}"
                        }
                    }
                },
                {
                    "name": "Get Current User",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": "{{baseUrl}}/auth/me"
                    }
                }
            ]
        },
        {
            "name": "Users",
            "item": [
                {
                    "name": "Update Profile",
                    "request": {
                        "method": "PUT",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": "{{baseUrl}}/users/profile",
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"username\": \"newusername\",\n  \"bio\": \"Hello, I'm using Nearby Chat!\"\n}"
                        }
                    }
                },
                {
                    "name": "Update Location",
                    "request": {
                        "method": "PUT",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": "{{baseUrl}}/users/location",
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"latitude\": 23.0225,\n  \"longitude\": 72.5714,\n  \"address\": \"Ahmedabad, Gujarat, India\"\n}"
                        }
                    }
                },
                {
                    "name": "Get Nearby Users",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": "{{baseUrl}}/users/nearby?latitude=23.0225&longitude=72.5714&radius=5000"
                    }
                },
                {
                    "name": "Search Users",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": "{{baseUrl}}/users/search?query=test"
                    }
                }
            ]
        },
        {
            "name": "Chats",
            "item": [
                {
                    "name": "Get All Chats",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": "{{baseUrl}}/chats"
                    }
                },
                {
                    "name": "Create Private Chat",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": "{{baseUrl}}/chats/private/:userId"
                    }
                }
            ]
        },
        {
            "name": "Messages",
            "item": [
                {
                    "name": "Get Messages",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": "{{baseUrl}}/messages/:chatId"
                    }
                },
                {
                    "name": "Send Message",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": "{{baseUrl}}/messages",
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"chatId\": \"chat_id_here\",\n  \"content\": \"Hello, World!\",\n  \"type\": \"text\"\n}"
                        }
                    }
                }
            ]
        },
        {
            "name": "Groups",
            "item": [
                {
                    "name": "Create Group",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": "{{baseUrl}}/groups",
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"groupName\": \"My Group\",\n  \"participants\": [\"user_id_1\", \"user_id_2\"]\n}"
                        }
                    }
                }
            ]
        }
    ]
}